MONGO_URI=mongodb://localhost:27017/trackathlete
JWT_SECRET=change_this_secret_before_deploying
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# --- TrackMate AI assistant (Google Gemini) ---
# Server-side only. Never expose this key to the browser or commit a real value.
# Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxx
# Any current Gemini text model. Prefer a "-latest" alias: pinned versions get
# retired (the 2.5 family already returns 404 for new API keys) and would break
# TrackMate overnight. Verified working: gemini-flash-lite-latest (~1.5s),
# gemini-3.1-flash-lite (~1.7s). Avoid gemini-3.6-flash here: its reasoning pass
# took ~200s on this prompt.
GEMINI_MODEL=gemini-flash-lite-latest

# --- Optional TrackMate tuning (safe defaults are used when unset) ---
# GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# TRACKMATE_TIMEOUT_MS=25000
# TRACKMATE_MAX_MESSAGE_CHARS=2000
# TRACKMATE_MAX_HISTORY_TURNS=8
# TRACKMATE_MAX_OUTPUT_TOKENS=1500
# TRACKMATE_MAX_REPLY_CHARS=4000
# TRACKMATE_RATE_SHORT_MAX=10
# TRACKMATE_RATE_SHORT_WINDOW_MS=60000
# TRACKMATE_RATE_LONG_MAX=120
# TRACKMATE_RATE_LONG_WINDOW_MS=3600000
# TRACKMATE_MAX_ITEMS_PER_DATASET=5
# TRACKMATE_RECOMMEND_RADIUS_KM=300
# TRACKMATE_RECOMMEND_CACHE_TTL_MS=600000
